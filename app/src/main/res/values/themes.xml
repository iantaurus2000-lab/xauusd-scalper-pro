<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.XAUUSDScalper" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#05080C</item>
        <item name="android:statusBarColor">#05080C</item>
        <item name="android:navigationBarColor">#05080C</item>
        <item name="android:colorPrimary">#1B5E20</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#E0E0E0</item>
        <item name="android:colorBackground">#121212</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:buttonStyle">@style/BrightButton</item>
    </style>

    <style name="BrightButton" parent="android:Widget.Material.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DialogDark" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:background">#1E1E1E</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:colorAccent">#00E676</item>
    </style>
</resources>
