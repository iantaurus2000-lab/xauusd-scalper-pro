<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#05080C"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XAUUSD BIQUOTE SCALPER"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/connection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE 1s"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <Button
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="≡"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="#263238" />
    </LinearLayout>

    <TextView
        android:id="@+id/ticker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFD54F"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollHorizontally="true"
        android:layout_marginTop="4dp"
        android:text="Session..." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="4dp">
        <TextView
            android:id="@+id/price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="----.--"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:id="@+id/priceChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0.00"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/spreadLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spread --"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/highLow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="H --  L --"
        android:textColor="#CFD8DC"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/resultsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada hasil entry."
        android:textColor="#80CBC4"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0F1620"
        android:padding="10dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/lamp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⚪"
            android:textSize="30sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">
            <TextView
                android:id="@+id/signalState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WAIT"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/confidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☆☆☆☆☆  0%"
                android:textColor="#69F0AE"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:background="#0F1620"
        android:padding="8dp">
        <TextView android:id="@+id/boxEntry" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="Entry\n--" android:textColor="#FFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/boxSl" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="SL\n--" android:textColor="#FF8A80" android:textSize="12sp" />
        <TextView android:id="@+id/boxTp1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="TP1\n--" android:textColor="#69F0AE" android:textSize="12sp" />
        <TextView android:id="@+id/boxTp2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="TP2\n--" android:textColor="#69F0AE" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">
        <Button
            android:id="@+id/btnCopyAll"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="SALIN SEMUA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1565C0" />
        <Button
            android:id="@+id/btnOpenMt5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="BUKA MT5"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#2E7D32"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <Button android:id="@+id/btnCopyEntry" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="ENTRY" android:textSize="12sp" android:textColor="#FFFFFF" android:background="#37474F" />
        <Button android:id="@+id/btnCopySl" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="SL" android:textSize="12sp" android:textColor="#FFFFFF" android:background="#37474F" android:layout_marginStart="4dp" />
        <Button android:id="@+id/btnCopyTp" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="TP1" android:textSize="12sp" android:textColor="#FFFFFF" android:background="#37474F" android:layout_marginStart="4dp" />
        <Button android:id="@+id/btnMarkWin" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="WIN" android:textSize="12sp" android:textColor="#FFFFFF" android:background="#1B5E20" android:layout_marginStart="4dp" />
        <Button android:id="@+id/btnMarkLoss" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="LOSS" android:textSize="12sp" android:textColor="#FFFFFF" android:background="#B71C1C" android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/signalDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#B0BEC5"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:text="M5 · Sweep · Wick · Tip · BOS" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <Button android:id="@+id/tfM1" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="M1" android:textSize="13sp" android:textColor="#FFFFFF" android:background="#455A64" />
        <Button android:id="@+id/tfM5" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="M5" android:textSize="13sp" android:textColor="#FFFFFF" android:background="#455A64" android:layout_marginStart="4dp" />
        <Button android:id="@+id/tfM15" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="M15" android:textSize="13sp" android:textColor="#FFFFFF" android:background="#455A64" android:layout_marginStart="4dp" />
    </LinearLayout>

    <com.xauusd.scalper.CandleChartView
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <TextView android:id="@+id/m5Bias" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="M5 -" android:textColor="#B2FF59" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/m1State" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="M1 -" android:textColor="#B2FF59" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">
        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="START"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1B5E20" />
        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="STOP"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#B71C1C"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#90A4AE"
        android:textSize="11sp"
        android:layout_marginTop="4dp"
        android:text="Log: v5.12" />
</LinearLayout>
